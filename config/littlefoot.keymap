#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        Prodrafts_Lasso_backspace: Prodrafts_Lasso_backspace {
            compatible = "zmk,behavior-tap-dance";
            label = "PRODRAFTS_LASSO_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base1 {
            display-name = "Base";
            bindings = <
&kp NUMBER_1      &kp N2        &kp N3     &kp N4            &kp N5  &kp N6  &kp N7  &kp N8  &kp N9          &kp N0
&kp Q             &kp W         &kp E      &kp R             &kp T   &kp Y   &kp U   &kp I   &kp O           &kp P
&kp A             &kp S         &kp D      &kp F             &kp G   &kp H   &kp J   &kp K   &kp L           &kp ENTER
&to 1             &kp Z         &kp X      &kp C             &kp V   &kp B   &kp N   &kp M   &kp DOWN_ARROW  &to 2
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &kp LEFT_COMMAND
            >;
        };

        Base2 {
            display-name = "2nd base";
            bindings = <
&kp ESCAPE        &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp N4     &kp N5     &kp N6     &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT      &kp BACKSPACE
&kp LS(Q)         &kp LS(W)             &kp LS(E)             &kp LS(R)  &kp LS(T)  &kp LS(Y)  &kp LS(U)       &kp LS(I)         &kp LS(O)       &kp LS(P)
&kp LS(A)         &kp LS(S)             &kp LS(D)             &kp LS(F)  &kp LS(G)  &kp LS(H)  &kp LS(J)       &kp LS(K)         &kp LS(L)       &kp UP_ARROW
&to 0             &kp LS(X)             &kp LS(C)             &kp LS(V)  &kp LS(B)  &kp LS(N)  &kp LS(M)       &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT
&kp LEFT_CONTROL  &kp LEFT_ALT          &kp LEFT_COMMAND      &kp ENTER
            >;
        };

        Nav {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans             &trans          &out OUT_TOG    &bt BT_CLR         &bt BT_CLR_ALL
&to 3           &to 4             &trans        &trans        &trans        &trans             &trans          &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT
&trans          &trans            &trans        &trans        &trans        &kp LG(BACKSPACE)  &kp UP_ARROW    &kp ENTER       &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC
&kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans        &kp LEFT           &kp DOWN_ARROW  &kp RIGHT       &kp C_VOLUME_DOWN  &kp C_BRI_DEC
&bt BT_PRV      &bt BT_NXT        &to 0         &to 0
            >;
        };

        Prodrafts {
            bindings = <
&Prodrafts_Lasso_backspace  &kp E          &kp R         &trans  &trans  &trans  &trans  &trans  &trans             &to 2
&kp LG(Z)                   &kp LG(LS(Z))  &kp G         &trans  &trans  &trans  &trans  &trans  &trans             &trans
&kp N5                      &kp NUMBER_6   &kp N7        &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_UP    &kp C_BRI_INC
&kp NUMBER_2                &kp NUMBER_3   &kp NUMBER_4  &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC
&kp NUMBER_1                &kp LG(TAB)    &to 2         &trans
            >;
        };

        Noteful {
            bindings = <
&kp F       &kp E           &kp H          &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_6   &trans         &trans          &trans          &to 2
&kp G       &kp A           &kp BACKSPACE  &kp NUMBER_3   &kp NUMBER_4  &trans         &trans         &trans          &trans          &kp LS(SPACE)
&kp LG(Z)   &kp LG(LS(Z))   &kp BACKSPACE  &kp N5         &kp NUMBER_6  &trans         &trans         &trans          &kp UP_ARROW    &kp SPACE
&kp LG(N0)  &kp LG(LS(N0))  &kp LG(MINUS)  &kp LG(EQUAL)  &trans        &kp LG(MINUS)  &kp LG(EQUAL)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT
&kp LEFT    &kp RIGHT       &kp LG(N0)     &kp LG(TAB)
            >;
        };
    };
};
